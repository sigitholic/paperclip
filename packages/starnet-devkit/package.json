{
  "name": "@starnet/devkit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Starnet developer kit: patch bookkeeping checks, upstream sync, demo seed, fake device servers and E2E against a local Paperclip instance.",
  "scripts": {
    "seed": "node ./scripts/demo-seed.mjs",
    "fake-servers": "node ./scripts/fake-servers.mjs",
    "e2e": "vitest run --config ./vitest.config.mjs e2e",
    "test": "vitest run --config ./vitest.config.mjs tests",
    "typecheck": "node --check ./scripts/core-diff-check.mjs && node --check ./scripts/demo-seed.mjs && node --check ./scripts/fake-servers.mjs && bash -n ./scripts/upstream-sync.sh",
    "build": "node -e \"\"",
    "check:core": "node ./scripts/core-diff-check.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
